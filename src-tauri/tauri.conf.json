{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vidbase",
  "version": "0.2.4",
  "identifier": "com.adelar.vidbase",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Minha Biblioteca",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "minWidth": 1024,
        "minHeight": 768,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": "default-src 'self' asset: http://asset.localhost https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data: http://127.0.0.1:8765; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data: http://127.0.0.1:8765; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxRTI3NjNGMUI3N0Q5NTEKUldSUjJYY2JQM2Jpc1pqS3ZKUjEvNXp2bVpHaE9JeTc3M1dFdFkwN1ZJa3k5ZVZSNTBLeS9WTzcK",
      "endpoints": [
        "https://github.com/uilian-comim/vid-base-app/releases/latest/download/latest.json"
      ]
    }
  }
}